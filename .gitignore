# Rust
/target
**/*.rs.bk
*.pdb

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*.swo

# Local agent state
.claude/settings.local.json

# Personal sync script (mirrors to private monorepo)
sync-to-monorepo.sh

# Generated demo mesh (built by build-demo.sh; contains ephemeral W-OTS keys)
examples/helios-robotics/mesh/

# Local-only files — not synced to GitHub
local/

# Local dogfood mesh — the Crux Mesh repo's own crux state (not for the public repo)
/.crux-mesh.json
/.crux-audit.json
/policy/
/code/
/coms/

# Local MCP registration (personal machine paths — not for the public repo)
/.mcp.json

# Harness-specific local state. settings.local.json is personal by Claude Code's
# own convention (the .local. variant is never shared) and allowlists MCP servers
# that exist on one machine. Agent-facing guidance that belongs to the project
# lives in CRUX_AGENT_SPEC.md (vendor-neutral) and CLAUDE.md (harness layer).
/.claude/
